{
  "name": "trucado",
  "productName": "Trucado",
  "version": "1.0.1",
  "description": "Roguelike de deckbuilding no estilo Balatro sobre as regras do Truco Paulista, num boteco brasileiro.",
  "author": "Breno Nunes",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint .",
    "simulate": "vite-node scripts/simulate.ts",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "npm run build && electron-builder --win --publish always",
    "dist:web": "npm run build && node -e \"require('fs').mkdirSync('release',{recursive:true})\" && tar -a -c -f release/Trucado-web.zip -C dist .",
    "retratos": "node scripts/retratos/gerar.mjs",
    "retratos:prompts": "node scripts/retratos/gerar.mjs --prompts",
    "server": "vite-node server/index.ts",
    "server:build": "vite build --ssr server/index.ts --outDir server-dist --emptyOutDir",
    "server:start": "node server-dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/yanone-kaffeesatz": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "br.trucado.jogo",
    "productName": "Trucado",
    "copyright": "Breno Nunes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Trucado",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "Trucado-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Trucado-${version}-portatil.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BrenoNunesC",
        "repo": "trucado"
      }
    ]
  },
  "dependencies": {
    "@fontsource/bowlby-one": "5.3.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  }
}
